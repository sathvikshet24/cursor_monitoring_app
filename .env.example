# Copy to .env for local use. Do not commit .env.
# Placeholders only — replace with your own values.

FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

# Single admin account (password is hashed in-memory at startup; never stored plaintext in the DB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: set a precomputed Werkzeug hash instead of ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=
