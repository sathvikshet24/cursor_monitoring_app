# Copy to .env for local use. Do not commit .env.
# Placeholders only — replace with your own values.

FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

# Single admin account (password is hashed in-memory at startup; never stored plaintext in the DB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: set a precomputed Werkzeug hash instead of ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=

# SQLite registry (default: instance/monitoring.db under the app package)
# DATABASE_PATH=/absolute/path/to/monitoring.db

# Global SSH defaults (optional). Prefer per-server credentials on the Add server form.
# SSH_USER=
# SSH_KEY_PATH=
# SSH_PASSWORD=
SSH_PORT=22
SSH_TIMEOUT=10
# false = AutoAddPolicy (convenient for local/lab demo including localhost)
SSH_STRICT_HOST_KEY=false

# Dashboard metrics poll interval in milliseconds (default 30000 = 30s)
# REFRESH_INTERVAL_MS=30000
